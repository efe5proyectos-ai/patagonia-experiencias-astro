---
import '../styles/global.css';
import { TEXTOS, WHATSAPP, waPt } from '../lib/traducciones.js';
// Layout con el diseño real de producción: Tailwind + Montserrat/Inter + fucsia E91E63
// idioma: 'es' | 'pt'. alternos: { es: urlAbsoluta, pt: urlAbsoluta } → genera hreflang recíproco
const {
  titulo, descripcion,
  imagen = 'https://patagoniaexperiencias.com/og-image.jpg',
  schema = null, tipo = 'website', temaOscuro = false,
  idioma = 'es', alternos = null, noindex = false,
} = Astro.props;
const T = TEXTOS[idioma] || TEXTOS.es;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const tituloCompleto = `${titulo} | Patagonia Experiencias`;
const hayAlternos = alternos && alternos.es && alternos.pt;
const linkOtroIdioma = hayAlternos ? (idioma === 'pt' ? alternos.es : alternos.pt) : null;
const urlWhatsApp = idioma === 'pt'
  ? waPt({ ref: 'barra' })
  : `https://wa.me/${WHATSAPP.es}`;
// Medición: el mismo GA4 y el mismo Pixel que usa el resto del sitio.
// Hasta ahora las páginas generadas con Astro (/experiencias/, /guias/, /pt-br/)
// no tenían ninguno de los dos: todo el tráfico de los anuncios caía acá sin medir.
const GA4 = 'G-NF2R0BJG34';
const PIXEL = '1501384968138883';
const schemaOrg = {
  '@context': 'https://schema.org', '@type': 'Organization',
  name: 'Patagonia Experiencias', url: 'https://patagoniaexperiencias.com',
  sameAs: ['https://www.instagram.com/patagoniaexperienciasok'],
};
---
<!doctype html>
<html lang={T.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagen} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={T.og} />
    {hayAlternos && <meta property="og:locale:alternate" content={idioma === 'pt' ? 'es_AR' : 'pt_BR'} />}
    {hayAlternos && <link rel="alternate" hreflang="es-AR" href={alternos.es} />}
    {hayAlternos && <link rel="alternate" hreflang="pt-BR" href={alternos.pt} />}
    {hayAlternos && <link rel="alternate" hreflang="x-default" href={alternos.es} />}
    <meta property="og:site_name" content="Patagonia Experiencias" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA4}`}></script>
    <script is:inline define:vars={{ GA4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag('js', new Date());
      gtag('config', GA4);
    </script>
    <script is:inline define:vars={{ PIXEL }}>
      !function (f, b, e, v, n, t, s) {
        if (f.fbq) return; n = f.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments) };
        if (!f._fbq) f._fbq = n; n.push = n; n.loaded = !0; n.version = '2.0'; n.queue = [];
        t = b.createElement(e); t.async = !0; t.src = v; s = b.getElementsByTagName(e)[0]; s.parentNode.insertBefore(t, s)
      }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', PIXEL);
      fbq('track', 'PageView');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  </head>
  <body style="overflow-x:clip" class:list={["font-body antialiased", temaOscuro ? "bg-[#0d1117] text-white" : "bg-brand-light text-slate-800"]}>

    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-[72px] flex items-center justify-between gap-3">
        <a href={T.inicio} class="font-sans font-extrabold text-[15px] min-[380px]:text-base sm:text-lg tracking-tight text-brand-oxford whitespace-nowrap shrink-0">
          Patagonia<span class="text-brand-fuchsia">Experiencias</span>
        </a>
        <nav class="flex items-center gap-1 min-w-0">
          <a href="/guias/" class="hidden md:flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full text-slate-500 hover:bg-brand-fuchsia/5 hover:text-brand-fuchsia transition-all"><i class="fa-solid fa-newspaper"></i> {T.revista}</a>
          <a href={idioma === 'pt' ? '/pt-br/experiencias/' : '/experiencias/'} class="hidden md:flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full text-slate-500 hover:bg-brand-fuchsia/5 hover:text-brand-fuchsia transition-all"><i class="fa-solid fa-compass"></i> {T.experiencias}</a>
          <a href="/guias-de-viaje/" class="hidden md:flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full text-slate-500 hover:bg-brand-fuchsia/5 hover:text-brand-fuchsia transition-all"><i class="fa-solid fa-book-open"></i> {T.guia}</a>
          <a href="https://tienda.patagoniapuntos.com" target="_blank" rel="noopener noreferrer" class="hidden md:flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-2 rounded-full text-slate-500 hover:bg-brand-fuchsia/5 hover:text-brand-fuchsia transition-all"><i class="fa-solid fa-coins"></i> {T.puntos}</a>
          {linkOtroIdioma && <a href={linkOtroIdioma} hreflang={idioma === 'pt' ? 'es-AR' : 'pt-BR'} class="hidden sm:flex items-center gap-1.5 text-xs font-bold uppercase tracking-widest px-3 py-2 rounded-full text-slate-500 hover:text-brand-fuchsia transition-all"><i class="fa-solid fa-globe"></i> {T.idiomaOtro}</a>}
          <a href={idioma === 'pt' ? '/pt-br/experiencias/' : 'https://patagoniaexperiencias.com/#experiencias'} class="flex shrink-0 items-center gap-2 text-[11px] sm:text-xs font-bold uppercase tracking-wider sm:tracking-widest px-3 sm:px-5 py-2.5 rounded-full bg-brand-fuchsia text-white shadow-lg shadow-brand-fuchsia/30 hover:bg-brand-fuchsiaDark transition-all"><i class="fa-solid fa-ticket hidden sm:inline"></i> {T.reservar}</a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="bg-brand-dark text-white mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 grid md:grid-cols-4 gap-10">
        <div>
          <p class="font-sans font-extrabold text-lg mb-3">Patagonia<span class="text-brand-fuchsia">Experiencias</span></p>
          <p class="text-sm text-white/60 leading-relaxed">{T.lema}</p>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-4">{T.eco}</p>
          <ul class="space-y-2 text-sm">
            <li><a href="/guias/" class="text-white/70 hover:text-brand-fuchsia transition-colors">{T.revistaGuias}</a></li>
            <li><a href={idioma === 'pt' ? '/pt-br/experiencias/' : '/experiencias/'} class="text-white/70 hover:text-brand-fuchsia transition-colors">{T.experiencias}</a></li>
            <li><a href="https://tienda.patagoniapuntos.com" class="text-white/70 hover:text-brand-fuchsia transition-colors">Patagonia Puntos</a></li>
            {idioma !== 'pt' && <li><a href="https://patagoniaexperiencias.com/prestadores.html" class="text-white/70 hover:text-brand-fuchsia transition-colors">{T.prestador}</a></li>}
          </ul>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-4">{idioma === 'pt' ? 'Destinos e guias' : 'Destinos y guías'}</p>
          <ul class="space-y-2 text-sm">
            <li><a href="/guias-de-viaje/peninsula-valdes/" class="text-white/70 hover:text-brand-fuchsia transition-colors">Península Valdés</a></li>
            <li><a href="/puerto-madryn" class="text-white/70 hover:text-brand-fuchsia transition-colors">Puerto Madryn</a></li>
            <li><a href="/guias-de-viaje/valle-del-chubut/" class="text-white/70 hover:text-brand-fuchsia transition-colors">Valle del Chubut</a></li>
            <li><a href="/guias-de-viaje/valle-del-chubut/trelew/" class="text-white/70 hover:text-brand-fuchsia transition-colors">Trelew</a></li>
            <li><a href="/guias-de-viaje/valle-del-chubut/gaiman/" class="text-white/70 hover:text-brand-fuchsia transition-colors">Gaiman</a></li>
            <li><a href="/guias-de-viaje/esquel-trevelin/" class="text-white/70 hover:text-brand-fuchsia transition-colors">Esquel y Trevelin</a></li>
            <li><a href="/calendario-fauna/" class="text-white/70 hover:text-brand-fuchsia transition-colors">{idioma === 'pt' ? 'Calendário de fauna' : 'Calendario de fauna'}</a></li>
            <li><a href={idioma === 'pt' ? '/' : '/pt-br/'} hreflang={idioma === 'pt' ? 'es-AR' : 'pt-BR'} class="text-white/70 hover:text-brand-fuchsia transition-colors">{idioma === 'pt' ? 'Versión en español' : 'Em português 🇧🇷'}</a></li>
          </ul>
        </div>
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-4">{T.contacto}</p>
          <p class="text-sm text-white/70">efe5 proyectos SRL · Trelew, Chubut, Argentina</p>
          <a href="https://www.instagram.com/patagoniaexperienciasok" class="inline-flex items-center gap-2 mt-3 text-sm text-white/70 hover:text-brand-fuchsia transition-colors"><i class="fa-brands fa-instagram"></i> @patagoniaexperienciasok</a>
        </div>
      </div>
      <!-- Respaldo institucional y pagos: mismo bloque en ES y PT -->
      <div class="border-t border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 grid gap-10 lg:grid-cols-[1fr_auto] items-center">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-5 text-center lg:text-left">{idioma === 'pt' ? 'Parceiros institucionais' : 'Nos acompañan'}</p>
            <ul class="flex flex-wrap justify-center lg:justify-start items-center gap-4">
              <li class="h-20 px-6 rounded-xl bg-white/5 border border-white/10 flex items-center">
                <img src="/assets/institucional/chubut-seguro.png" alt={idioma === 'pt' ? 'Chubut Seguro — turismo formal' : 'Chubut Seguro — turismo formal'} width="520" height="227" loading="lazy" class="h-12 w-auto" />
              </li>
              <li class="h-20 px-5 rounded-xl bg-white flex items-center">
                <img src="/assets/institucional/ahg-trelew.png" alt="Asociación Hotelera Gastronómica de Trelew y Valle del Chubut" width="172" height="121" loading="lazy" class="h-14 w-auto" />
              </li>
              <li class="h-20 px-5 rounded-xl bg-[#f2f2f2] flex items-center">
                <img src="/assets/institucional/cat-chubut.png" alt="Cámara de Turismo del Chubut" width="360" height="254" loading="lazy" class="h-14 w-auto" />
              </li>
            </ul>
          </div>
          <div class="text-center lg:text-right">
            <p class="text-xs font-bold uppercase tracking-widest text-white/40 mb-5">{idioma === 'pt' ? 'Pagamento seguro' : 'Pagos seguros'}</p>
            <div class="inline-flex h-20 px-5 rounded-xl bg-[#f7f7f7] items-center">
              <img src="/assets/institucional/medios-de-pago.png" alt={idioma === 'pt' ? 'Pagamento via Mercado Pago: Visa, Mastercard, American Express e outros' : 'Pagos vía Mercado Pago: Visa, Mastercard, American Express y más'} width="466" height="58" loading="lazy" class="h-9 w-auto max-w-full" />
            </div>
          </div>
        </div>
      </div>
      <div class="border-t border-white/10 py-5 text-center text-xs text-white/40">© 2026 Patagonia Experiencias · {T.derechos}</div>
    </footer>

    {/* WhatsApp: botón flotante en escritorio y barra fija abajo en celular */}
    <a href={urlWhatsApp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" data-wa-ref="barra"
       class="hidden md:flex fixed bottom-6 right-6 w-14 h-14 bg-[#25D366] hover:bg-[#1ebe5b] text-white rounded-full items-center justify-center text-3xl shadow-lg shadow-green-500/30 z-50 transition-all">
      <i class="fa-brands fa-whatsapp"></i>
    </a>
    <a href={urlWhatsApp} target="_blank" rel="noopener noreferrer" data-wa-ref="barra"
       class="md:hidden fixed inset-x-0 bottom-0 z-50 flex items-center justify-center gap-2.5 bg-[#25D366] active:bg-[#1ebe5b] text-white font-bold text-[15px] shadow-[0_-4px_14px_rgba(0,0,0,.15)]"
       style="min-height:56px;padding-bottom:env(safe-area-inset-bottom)">
      <i class="fa-brands fa-whatsapp text-2xl"></i>
      <span>{idioma === 'pt' ? 'Fale conosco no WhatsApp' : 'Consultanos por WhatsApp'}</span>
    </a>
    <div class="md:hidden" style="height:calc(56px + env(safe-area-inset-bottom))" aria-hidden="true"></div>

    {/* Cada clic a WhatsApp queda registrado en GA4 y en el Pixel, con el tour
        y el lugar del que salió. De ahí sale el informe de consultas. */}
    <script is:inline define:vars={{ idioma }}>
      document.addEventListener('click', function (ev) {
        var a = ev.target && ev.target.closest ? ev.target.closest('a[href*="wa.me"]') : null;
        if (!a) return;
        var datos = {
          idioma: idioma,
          tour: a.getAttribute('data-wa-tour') || '(sin tour)',
          lugar: a.getAttribute('data-wa-ref') || 'site',
          pagina: location.pathname,
        };
        try { if (window.gtag) window.gtag('event', 'contacto_whatsapp', datos); } catch (e) {}
        try { if (window.fbq) window.fbq('track', 'Contact', datos); } catch (e) {}
      }, true);
    </script>
    {idioma === 'pt' && (
      <script is:inline>
        // Referencia en reales: cotización BRL→ARS del día (open.er-api.com), guardada 12 h en el navegador.
        // Si la consulta falla, los montos en R$ quedan ocultos y la página funciona igual.
        (function () {
          var els = document.querySelectorAll('.pe-brl[data-ars]');
          if (!els.length) return;
          function pintar(arsPorBrl) {
            if (!(arsPorBrl > 0)) return;
            els.forEach(function (el) {
              var ars = Number(el.getAttribute('data-ars'));
              if (!(ars > 0)) return;
              var v = el.querySelector('.pe-brl-valor');
              if (v) v.textContent = Math.round(ars / arsPorBrl).toLocaleString('pt-BR');
              el.hidden = false;
            });
          }
          var CLAVE = 'pe_cotiz_brl_ars';
          try {
            var c = JSON.parse(localStorage.getItem(CLAVE) || 'null');
            if (c && c.valor > 0 && Date.now() - c.t < 12 * 3600 * 1000) { pintar(c.valor); return; }
          } catch (e) {}
          fetch('https://open.er-api.com/v6/latest/BRL')
            .then(function (r) { return r.json(); })
            .then(function (d) {
              var valor = d && d.result === 'success' && d.rates && d.rates.ARS;
              if (!(valor > 0)) return;
              try { localStorage.setItem(CLAVE, JSON.stringify({ valor: valor, t: Date.now() })); } catch (e) {}
              pintar(valor);
            })
            .catch(function () {});
        })();
      </script>
    )}
  </body>
</html>
