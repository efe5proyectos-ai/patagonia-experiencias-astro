---
// Ficha de passeio em português (pt-BR). Gerada só para tours traduzidos.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { obtenerExperienciasPt, urlEs, aReales, WHATSAPP, relacionadas } from '../../../lib/traducciones.js';
import Tarjeta from '../../../components/TarjetaPt.astro';

export async function getStaticPaths() {
  const exps = await obtenerExperienciasPt();
  return exps.map((exp) => ({ params: { slug: exp.slug }, props: { exp, rel: relacionadas(exp, exps) } }));
}

const { exp, rel } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const alternos = { es: urlEs(exp.slugEs), pt: url };
const limpio = exp.descripcion.replace(/<script[\s\S]*?<\/script>/gi, '');
const textoPlano = limpio.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const descripcion = exp.metaDescricao || textoPlano.slice(0, 152).trim() + '…';
const etiquetaDuracion = { par_horas: 'Algumas horas', medio_dia: 'Meio dia', dia_completo: 'Dia inteiro' }[exp.duracion] || exp.duracion;
const fmt = (n) => Number(n).toLocaleString('pt-BR');
const reales = aReales(exp.precio);

const schema = [
  { '@context': 'https://schema.org', '@type': 'Product', name: exp.titulo,
    image: exp.imagenes.length ? exp.imagenes : exp.imagen, description: textoPlano.slice(0, 300),
    brand: { '@type': 'Brand', name: 'Patagonia Experiencias' },
    ...(exp.precio && { offers: { '@type': 'Offer', price: String(exp.precio), priceCurrency: 'ARS',
      availability: 'https://schema.org/InStock', url,
      seller: { '@type': 'Organization', name: exp.proveedor || 'Patagonia Experiencias' } } }) },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Início', item: 'https://patagoniaexperiencias.com/pt-br/' },
    { '@type': 'ListItem', position: 2, name: 'Passeios', item: 'https://patagoniaexperiencias.com/pt-br/experiencias/' },
    { '@type': 'ListItem', position: 3, name: exp.titulo, item: url } ] },
  ...(exp.faq.length ? [{ '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'pt-BR',
    mainEntity: exp.faq.map((f) => ({ '@type': 'Question', name: f.pergunta, acceptedAnswer: { '@type': 'Answer', text: f.resposta } })) }] : []),
];
---
<BaseLayout titulo={exp.titulo} descripcion={descripcion} imagen={exp.imagen} schema={schema} tipo="product" idioma="pt" alternos={alternos}>
  <main>
    {exp.imagen && (
      <div class="relative h-[45vh] min-h-[320px] overflow-hidden">
        <img src={exp.imagen} alt={exp.alt} width="1600" height="700" class="w-full h-full object-cover" loading="eager" fetchpriority="high" />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
        <div class="absolute bottom-0 inset-x-0 max-w-4xl mx-auto px-4 sm:px-6 pb-10">
          <div class="mb-4 flex flex-wrap gap-2">
            {exp.temporada && <span class="inline-block bg-brand-fuchsia text-white text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md"># {exp.temporada}</span>}
            {exp.categoria && <span class="inline-block bg-white/90 text-brand-oxford text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md">{exp.categoria}</span>}
          </div>
          <h1 class="font-sans font-extrabold text-2xl sm:text-4xl text-white leading-tight drop-shadow-lg">{exp.titulo}</h1>
        </div>
      </div>
    )}
    <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
      <nav class="text-xs font-bold uppercase tracking-widest text-slate-400 mb-6" aria-label="Navegação">
        <a href="/pt-br/" class="hover:text-brand-fuchsia">Início</a> <span class="mx-1">›</span> <a href="/pt-br/experiencias/" class="hover:text-brand-fuchsia">Passeios</a>
      </nav>
      <div class="flex flex-wrap gap-3 mb-8 text-xs font-bold uppercase tracking-widest text-slate-500">
        <span class="bg-white border border-slate-200 rounded-full px-4 py-2"><i class="fa-solid fa-location-dot mr-1.5 text-brand-fuchsia"></i>{exp.destino}</span>
        {etiquetaDuracion && <span class="bg-white border border-slate-200 rounded-full px-4 py-2"><i class="fa-regular fa-clock mr-1.5 text-brand-fuchsia"></i>{etiquetaDuracion}</span>}
        {exp.proveedor && <span class="bg-white border border-slate-200 rounded-full px-4 py-2"><i class="fa-solid fa-store mr-1.5 text-brand-fuchsia"></i>{exp.proveedor}</span>}
      </div>
      {exp.precio > 0 && (
        <div class="mb-8 max-w-md">
          {exp.precioLista && exp.precioLista > exp.precio && (
            <p class="text-slate-400 line-through font-sans font-bold text-xl">${fmt(exp.precioLista)}</p>
          )}
          <p>
            <span class="font-sans font-extrabold text-4xl text-brand-fuchsia">${fmt(exp.precio)}</span>
            <span class="text-slate-400 text-sm font-bold ml-1">pesos argentinos (ARS)</span>
          </p>
          {reales > 0 && <p class="text-slate-500 text-sm font-semibold mt-1">≈ R$ {fmt(reales)} <span class="text-slate-400 font-normal">(valor de referência)</span></p>}
          {exp.precios.sena > 0 && (
            <div class="mt-4 bg-brand-fuchsia text-white rounded-xl px-5 py-4 flex items-center justify-between gap-4 shadow-lg shadow-brand-fuchsia/25">
              <span class="text-[11px] font-black uppercase tracking-widest leading-tight">⚡ Garanta sua vaga<br/>hoje com</span>
              <span class="text-right">
                <span class="font-sans font-extrabold text-3xl">${fmt(exp.precios.sena)}</span>
                <span class="block text-[10px] font-bold uppercase tracking-widest opacity-80">Sinal de reserva</span>
              </span>
            </div>
          )}
        </div>
      )}
      <div class="prose-pe text-[17px] leading-relaxed text-slate-700 whitespace-pre-line" set:html={limpio} />

      {exp.faq.length > 0 && (
        <section class="mt-12">
          <h2 class="font-sans font-extrabold text-2xl text-brand-oxford mb-4">Perguntas frequentes</h2>
          <div class="space-y-3">
            {exp.faq.map((f) => (
              <details class="bg-white border border-slate-200 rounded-2xl p-5">
                <summary class="font-sans font-bold text-brand-oxford cursor-pointer">{f.pergunta}</summary>
                <p class="mt-3 text-slate-600 leading-relaxed">{f.resposta}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <aside class="mt-12 bg-gradient-to-br from-brand-fuchsia to-brand-fuchsiaDark rounded-3xl p-8 text-white shadow-2xl shadow-brand-fuchsia/20">
        <h2 class="font-sans font-extrabold text-2xl mb-2">Reserve este passeio</h2>
        <p class="text-white/80 mb-5">Pagamento online seguro pelo Mercado Pago, com operadores locais verificados.</p>
        <div class="flex flex-wrap gap-3">
          <a href={`/patagonia-experiencias.html#tour/${exp.slugEs}`} class="inline-flex items-center gap-2 bg-white text-brand-fuchsia font-bold text-sm uppercase tracking-widest px-6 py-3 rounded-full hover:bg-slate-100 transition-all"><i class="fa-solid fa-ticket"></i> Reservar agora</a>
          <a href={`https://wa.me/${WHATSAPP.pt}?text=${encodeURIComponent('Olá! Tenho interesse no passeio: ' + exp.titulo)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border-2 border-white/70 text-white font-bold text-sm uppercase tracking-widest px-6 py-3 rounded-full hover:bg-white/10 transition-all"><i class="fa-brands fa-whatsapp"></i> Tirar dúvidas</a>
        </div>
      </aside>
    </article>
    {rel.length > 0 && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-6">
        <h2 class="font-sans font-extrabold text-2xl text-brand-oxford mb-6">Outros passeios na região</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">{rel.map((e) => <Tarjeta e={e} />)}</div>
      </section>
    )}
  </main>
</BaseLayout>
